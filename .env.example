# GEMINI_API_KEY: Optional fallback
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client configuration (safe to expose, guarded by firestore.rules)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Wayfarer Express Backend URL (Groq, Telegram, Amadeus, OpenRouteService, Geoapify)
VITE_API_BASE_URL=""

# Groq LLM API Key (used by server.ts as main LLM for destinations, places, guides, itineraries, and chat)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Cloudinary Unsigned Upload
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
